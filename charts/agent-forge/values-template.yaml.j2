{% set maintenance = agent_forge_maintenance | default(false) -%}
app:
  fullnameOverride: agent-forge
  ecrPullSecret:
    enabled: {{agent_forge is defined}}
    region: {{aws_region}}
  networkPolicy:
    enabled: {{agent_forge is defined}}
    appPort:
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: addon-prometheus
{% if agent_forge is defined %}
{#- Sandboxes: one Job per workspace in their own namespace. The model proxy port equals service.extraPorts[sandbox]. #}
{%- set sandbox_namespace = 'agent-forge-workspaces' %}
{%- set sandbox_port = 3104 %}
{%- set max_pods = workspace_max_pods | default(2) %}
{%- set memory_mb = workspace_memory_mb | default(1024) %}
{%- set disk_mb = workspace_disk_mb | default(2048) %}
{%- set cpus = workspace_cpus | default(1) %}
{%- set dns_cidrs = ['172.20.0.10/32'] %}
{%- set allow_public = workspace_allow_public | default(true) %}
{%- if (agent_runway is defined and agent_runway.connected | default(false)) %}
{#- Sandbox apps connect to retired pool databases and to the postgres and valkey servers of each Project's sandbox
    environment. The server NetworkPolicy and its password decide which Project a Sandbox reaches. #}
{%- set extra_egress = (workspace_extra_egress | default([])) + [{"to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "delivery-pool"}}}], "ports": [{"protocol": "TCP", "port": 5432}]}, {"to": [{"namespaceSelector": {"matchLabels": {"opspresso.com/delivery-tenant": "true", "opspresso.com/delivery-env": "dev"}}}], "ports": [{"protocol": "TCP", "port": 5432}, {"protocol": "TCP", "port": 6379}]}] %}
{%- else %}
{%- set extra_egress = workspace_extra_egress | default([]) %}
{%- endif %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-forge
  imagePullSecrets:
    - name: ecr-registry
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      HOSTNAME: 0.0.0.0
      PORT: '3103'
      AUTH_BASE_URL: https://{{agent_forge.hostname}}
      ALLOWED_ORIGINS: https://{{agent_forge.hostname}}
      FORGE_WORKER_ENABLED: 'true'
      FORGE_SANDBOX_PROVIDER: kubernetes
      FORGE_KUBE_IMAGE_PULL_SECRET: ecr-registry
      FORGE_KUBE_NODE_POOL: 'workspaces'
      # Workspace retention (agent-forge docs/CONTRACT.md): close a workspace suspended for 14 days,
      # delete its checkpoint 14 days after it closed and delete the workspace with its runs 30 days
      # after it closed. Closing and deletion cannot be undone.
      FORGE_SUSPENDED_WORKSPACE_RETENTION_DAYS: '14'
      FORGE_CLOSED_CHECKPOINT_RETENTION_DAYS: '14'
      FORGE_CLOSED_WORKSPACE_RETENTION_DAYS: '30'
      # Studio is the only sign-in authority; the callback is /api/auth/callback/studio.
      OIDC_ISSUER: https://{{agent_studio.hostname}}/api/auth
      OIDC_PROVIDER_ID: studio
      MODELS_URL: http://agent-models.agent-models.svc.cluster.local:3400
      # Required: every env declares agent_forge.model_roles ([] when it has no role).
      FORGE_MODEL_CHANNELS: {{agent_forge.model_roles | list | tojson | tojson}}
{%- if agent_forge.desktops | default(false) %}
      # Developer desktops (agent-platform docs/DEV_DESKTOP.md): each desktop pool's Entra app trusts this token
      # through a federated credential for system:serviceaccount:agent-forge:agent-forge (terraform-env-azure
      # dmz/8-forge-desktop). Pools and their Azure resources are set in the Forge console.
      FORGE_AZURE_TOKEN_FILE: /var/run/secrets/azure/tokens/azure-identity-token
{%- endif %}
{%- if (agent_runway is defined and agent_runway.connected | default(false)) %}
      # Run start materializes the Project's dev variables (agent-platform docs/DELIVERY_RESOURCES.md).
      RUNWAY_URL: http://agent-runway.agent-runway.svc.cluster.local:3500
{%- endif %}
      FORGE_SANDBOX_PORT: '{{sandbox_port}}'
      FORGE_SANDBOX_API_URL: http://agent-forge.agent-forge.svc.cluster.local:{{sandbox_port}}
      FORGE_SANDBOX_MEMORY_MB: '{{memory_mb}}'
      FORGE_SANDBOX_DISK_MB: '{{disk_mb}}'
      FORGE_SANDBOX_CPUS: '{{cpus}}'
      FORGE_KUBE_NAMESPACE: {{sandbox_namespace}}
      FORGE_INSTANCE: agent-forge-{{cluster}}
      FORGE_KUBE_RESOURCES_ENABLED: '{{resources | lower}}'
  # Prometheus reads this scrape token; the app reads the same value as METRICS_BEARER_TOKEN.
  extraExternalSecrets:
    agent-forge-metrics:
      data:
        - key: /k8s/{{cluster}}/agent-forge/metrics-bearer-token
          name: token
  # The sandbox namespace. Argo CD keeps it, and the workspaces in it, when the Application is removed.
  raw:
    enabled: true
    resources:
      - apiVersion: v1
        kind: Namespace
        metadata:
          name: {{sandbox_namespace}}
          annotations:
            argocd.argoproj.io/sync-wave: "-3"
            argocd.argoproj.io/sync-options: Prune=false,Delete=false
          labels:
            pod-security.kubernetes.io/enforce: baseline
            sidecar.istio.io/inject: "false"
      - apiVersion: v1
        kind: ServiceAccount
        metadata:
          name: sandbox
          namespace: {{sandbox_namespace}}
        automountServiceAccountToken: false
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: Role
        metadata:
          name: agent-forge-sandbox
          namespace: {{sandbox_namespace}}
        rules:
          - apiGroups: [""]
            resources: [pods]
            verbs: [get, list]
          - apiGroups: [batch]
            resources: [jobs]
            verbs: [get, list, create, delete]
          - apiGroups: [""]
            resources: [pods/exec]
            verbs: [get, create]
      - apiVersion: rbac.authorization.k8s.io/v1
        kind: RoleBinding
        metadata:
          name: agent-forge-sandbox
          namespace: {{sandbox_namespace}}
        subjects:
          - kind: ServiceAccount
            name: agent-forge
            namespace: agent-forge
        roleRef:
          apiGroup: rbac.authorization.k8s.io
          kind: Role
          name: agent-forge-sandbox
      # Every workspace at its limits fits: maxPods sandboxes of cpus, memoryMb and twice diskMb plus 512Mi.
      - apiVersion: v1
        kind: ResourceQuota
        metadata:
          name: agent-forge-sandbox
          namespace: {{sandbox_namespace}}
        spec:
          hard:
            pods: "{{max_pods}}"
            count/jobs.batch: "{{max_pods}}"
{%- if resources %}
            requests.cpu: "{{'%g' % (cpus * max_pods)}}"
            limits.cpu: "{{'%g' % (cpus * max_pods)}}"
            requests.memory: "{{memory_mb * max_pods}}Mi"
            limits.memory: "{{memory_mb * max_pods}}Mi"
            requests.ephemeral-storage: "{{(disk_mb * 2 + 512) * max_pods}}Mi"
            limits.ephemeral-storage: "{{(disk_mb * 2 + 512) * max_pods}}Mi"
{%- endif %}
      - apiVersion: networking.k8s.io/v1
        kind: NetworkPolicy
        metadata:
          name: sandbox-isolation
          namespace: {{sandbox_namespace}}
        spec:
          podSelector: {}
          policyTypes: [Ingress, Egress]
          ingress: []
          egress: []
      - apiVersion: networking.k8s.io/v1
        kind: NetworkPolicy
        metadata:
          name: sandbox-egress
          namespace: {{sandbox_namespace}}
        spec:
          podSelector:
            matchLabels:
              app.kubernetes.io/name: agent-forge-sandbox
          policyTypes: [Egress]
          egress:
            - to:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: kube-system
                  podSelector:
                    matchLabels:
                      k8s-app: kube-dns
{%- for cidr in dns_cidrs %}
                - ipBlock:
                    cidr: "{{cidr}}"
{%- endfor %}
              ports:
                - {protocol: UDP, port: 53}
                - {protocol: TCP, port: 53}
{%- if allow_public %}
            # The declared clusters use IPv4; policy CIDRs must match the cluster IP family.
            - to:
                - ipBlock:
                    cidr: 0.0.0.0/0
                    except: [0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4]
              ports:
                - {protocol: TCP, port: 80}
                - {protocol: TCP, port: 443}
{%- endif %}
            # Native CLIs reach only this installation's model proxy on the sandbox port.
            - to:
                - namespaceSelector:
                    matchLabels:
                      kubernetes.io/metadata.name: agent-forge
                  podSelector:
                    matchLabels:
                      app.kubernetes.io/name: agent-forge
                      app.kubernetes.io/instance: agent-forge-{{cluster}}
              ports:
                - {protocol: TCP, port: {{sandbox_port}}}
{%- for rule in extra_egress %}
            - {{rule | tojson}}
{%- endfor %}
  routing:
    hosts:
    - {{agent_forge.hostname}}
    httpRoute:
      enabled: true
  # core_tier: the base replicas prefer the on-demand core nodes (terraform-env-demo 51-core-node-pool.tf), one per AZ.
  # HPA growth and rollout surge spill over to Spot instead of waiting for core room.
{%- if core_tier | default(false) %}
  tolerations:
    - key: opspresso.com/tier
      operator: Equal
      value: core
      effect: NoSchedule
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: opspresso.com/tier
                operator: In
                values: [core]
{%- endif %}
  # Spread the replicas over AZs and nodes so one lost node leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-forge
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-forge
      matchLabelKeys: [pod-template-hash]
{% if agent_forge.desktops | default(false) %}
  # The token of FORGE_AZURE_TOKEN_FILE: audience api://AzureADTokenExchange, which the Entra federated credentials
  # require. The kubelet renews it before it expires.
  extraVolumes:
    - name: azure-identity-token
      projected:
        sources:
          - serviceAccountToken:
              audience: api://AzureADTokenExchange
              expirationSeconds: 3600
              path: azure-identity-token
  extraVolumeMounts:
    - name: azure-identity-token
      mountPath: /var/run/secrets/azure/tokens
      readOnly: true
{% endif %}
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_forge.hostname}}
  externalSecrets:
    enabled: true
    # Upper bound for an SSM edit to reach the Secret.
    refreshInterval: 15m
    data:
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-forge/checkpoint-secret
      name: FORGE_CHECKPOINT_SECRET
    - key: /k8s/{{cluster}}/agent-forge/model-secret
      name: FORGE_MODEL_SECRET
    - key: /k8s/{{cluster}}/agent-forge/oidc-client-id
      name: OIDC_CLIENT_ID
    - key: /k8s/{{cluster}}/agent-forge/oidc-client-secret
      name: OIDC_CLIENT_SECRET
    - key: /k8s/{{cluster}}/agent-forge/organization-id
      name: FORGE_ORGANIZATION_ID
    - key: /k8s/{{cluster}}/agent-forge/auth-secret
      name: AUTH_SECRET
    # Static scrape credential for /metrics, shared with Alloy and the ServiceMonitor.
    - key: /k8s/{{cluster}}/agent-forge/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
{% endif %}
