{% set maintenance = agent_forge_maintenance | default(false) -%}
app:
  fullnameOverride: agent-forge
  raw:
    enabled: {{agent_forge is defined}}
{% if agent_forge is defined %}
{% set oidc = agent_forge.oidc | default(none) %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-forge
  imagePullSecrets:
    - name: ecr-registry
{% if not resources %}
  resources: null
{% endif %}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'kube-system' if env == 'k3s' else 'istio-system'}}
{% if env == 'k3s' %}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-kube-system
{% endif %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'addon-alloy' if env == 'k3s' else 'addon-prometheus'}}
  registry:
    region: {{aws_region}}
  ssmPrefix: /k8s/{{cluster}}
  configmap:
    enabled: true
    data:
      HOST: 0.0.0.0
      PORT: '3103'
      AUTH_BASE_URL: https://{{agent_forge.hostname}}
      ALLOWED_ORIGINS: https://{{agent_forge.hostname}}
      FORGE_WORKER_ENABLED: 'true'
      FORGE_SANDBOX_PROVIDER: kubernetes
      FORGE_KUBE_IMAGE_PULL_SECRET: ecr-registry
      FORGE_KUBE_NODE_POOL: '{{ "workspaces" if env == "eks" else "" }}'
      FORGE_GIT_ALLOWED_ORIGINS: https://github.com
{%- if agent_forge.sign_in_domains is defined or oidc is not none %}
      # The default sign-in uses the Agent Memory Google client; an explicit oidc block overrides it.
      # Register the chosen provider identity on each callback, for example
      # https://<hostname>/api/auth/callback/google.
{% if oidc is not none %}
      OIDC_ISSUER: {{ oidc.issuer | tojson }}
      OIDC_PROVIDER_ID: {{ oidc.provider_id | default('oidc') | tojson }}
      OIDC_SCOPES: {{ oidc.scopes | default('openid email profile') | tojson }}
      OIDC_PROFILE_CLAIMS: {{ oidc.profile_claims | default({}) | tojson | tojson }}
{% else %}
      OIDC_ISSUER: https://accounts.google.com
      OIDC_PROVIDER_ID: google
{% endif %}
      ALLOWED_EMAIL_DOMAINS: '{{ agent_forge.sign_in_domains | join(",") }}'
{%- endif %}
  sandbox:
    namespace: agent-forge-workspaces
    maxPods: {{workspace_max_pods | default(2)}}
    memoryMb: {{workspace_memory_mb | default(1024)}}
    diskMb: {{workspace_disk_mb | default(2048)}}
    cpus: {{workspace_cpus | default(1)}}
    dnsCidrs:
      - {{ '172.20.0.10/32' if env == 'eks' else '10.43.0.10/32' }}
    allowPublic: {{workspace_allow_public | default(true)}}
    extraEgress: {{workspace_extra_egress | default([]) | tojson}}
  routing:
    hosts:
    - {{agent_forge.hostname}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_forge.hostname}}
    # Forge reads FORGE_MODEL_CHANNELS only at startup. After editing the model-channels SSM
    # parameter, wait one refreshInterval, then set this to the parameter version to restart Forge.
    agent-forge/model-channels-version: "3"
  externalSecrets:
    enabled: true
    # Upper bound for an SSM edit to reach the Secret.
    refreshInterval: 15m
    data:
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-forge/credentials
      name: FORGE_CREDENTIALS
    - key: /k8s/{{cluster}}/agent-forge/delegators
      name: FORGE_DELEGATORS
    - key: /k8s/{{cluster}}/agent-forge/issuer-policies
      name: FORGE_ISSUER_POLICIES
    - key: /k8s/{{cluster}}/agent-forge/checkpoint-secret
      name: FORGE_CHECKPOINT_SECRET
    - key: /k8s/{{cluster}}/agent-forge/credential-secret
      name: FORGE_GIT_CREDENTIAL_SECRET
    - key: /k8s/{{cluster}}/agent-forge/model-secret
      name: FORGE_MODEL_SECRET
    - key: /k8s/{{cluster}}/agent-forge/model-channels
      name: FORGE_MODEL_CHANNELS
{%- if agent_forge.sign_in_domains is defined or oidc is not none %}
{% if oidc is not none %}
    - key: {{ oidc.client_id_parameter | tojson }}
      name: OIDC_CLIENT_ID
    - key: {{ oidc.client_secret_parameter | tojson }}
      name: OIDC_CLIENT_SECRET
{% else %}
    - key: /k8s/common/agent-memory/google-client-id
      name: OIDC_CLIENT_ID
    - key: /k8s/common/agent-memory/google-client-secret
      name: OIDC_CLIENT_SECRET
{% endif %}
    - key: /k8s/{{cluster}}/agent-forge/organization-id
      name: FORGE_ORGANIZATION_ID
    - key: /k8s/{{cluster}}/agent-forge/session-secret
      name: AUTH_SECRET
{%- endif %}
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
{% endif %}
