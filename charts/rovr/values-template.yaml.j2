{% set maintenance = rovr_maintenance | default(false) -%}
app:
  fullnameOverride: rovr
  raw:
    enabled: {{rovr is defined}}
{% if rovr is defined %}
{% set sandbox = rovr.sandbox | default({}) %}
  replicaCount: {{0 if maintenance else 2}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/rovr
{% if not resources %}
  resources: null
{% endif %}
  ssmPrefix: /k8s/{{cluster}}
  registry:
    region: {{aws_region}}
  configmap:
    enabled: true
    data:
      ROVR_PUBLIC_URL: https://{{rovr.hostname}}
      GITHUB_APP_SLUG: {{rovr.github_app_slug | tojson}}
{% if rovr.allowed_logins | default([]) %}
      # Only these GitHub logins may sign in.
      ROVR_ALLOWED_LOGINS: {{rovr.allowed_logins | join(',') | tojson}}
{% endif %}
{% if rovr.operator_logins | default([]) %}
      # Only these GitHub logins may change anything and use the Helper.
      ROVR_OPERATOR_LOGINS: {{rovr.operator_logins | join(',') | tojson}}
{% endif %}
{% if rovr.tools_repo | default('') %}
      # Its owner's admins see and update the coding tool versions in Settings.
      ROVR_TOOLS_REPO: {{rovr.tools_repo | tojson}}
{% endif %}
  sandbox:
    maxRuns: {{sandbox.max_runs | default(2)}}
    maxWorkspaces: {{sandbox.max_workspaces | default(8)}}
    disk: {{sandbox.disk | default('10Gi') | tojson}}
    storageClass: {{sandbox.storage_class | default('') | tojson}}
    nodePool: {{sandbox.node_pool | default('') | tojson}}
    dnsCidrs:
      - 172.20.0.10/32
    allowPublic: {{sandbox.allow_public | default(true)}}
{% if sandbox.cache is defined %}
    cache:
      fileSystemId: {{sandbox.cache.file_system_id | tojson}}
      accessPointId: {{sandbox.cache.access_point_id | tojson}}
      size: {{sandbox.cache.size | default('50Gi') | tojson}}
{% endif %}
  routing:
    hosts:
    - {{rovr.hostname}}
    httpRoute:
      enabled: true
  # core_tier: the base replicas prefer the on-demand core nodes (terraform-env-demo 51-core-node-pool.tf), one per AZ.
  # HPA growth and rollout surge spill over to Spot instead of waiting for core room.
{%- if core_tier | default(false) %}
  tolerations:
    - key: opspresso.com/tier
      operator: Equal
      value: core
      effect: NoSchedule
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: opspresso.com/tier
                operator: In
                values: [core]
{%- endif %}
  # Spread the replicas over AZs and nodes so one lost node leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: rovr
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: rovr
      matchLabelKeys: [pod-template-hash]
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{rovr.hostname}}
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
  externalSecrets:
    enabled: true
    data:
    - key: /k8s/{{cluster}}/rovr/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/rovr/session-secret
      name: ROVR_SESSION_SECRET
    - key: /k8s/{{cluster}}/rovr/run-token-secret
      name: ROVR_RUN_TOKEN_SECRET
    - key: /k8s/{{cluster}}/rovr/secret-key
      name: ROVR_SECRET_KEY
    - key: /k8s/{{cluster}}/rovr/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
    # One GitHub App for sign-in, repository access and webhooks; see rovr docs/github-app.md.
    - key: /k8s/{{cluster}}/rovr/github-app-id
      name: GITHUB_APP_ID
    - key: /k8s/{{cluster}}/rovr/github-app-private-key
      name: GITHUB_APP_PRIVATE_KEY
    - key: /k8s/{{cluster}}/rovr/github-client-id
      name: GITHUB_APP_CLIENT_ID
    - key: /k8s/{{cluster}}/rovr/github-client-secret
      name: GITHUB_APP_CLIENT_SECRET
    - key: /k8s/{{cluster}}/rovr/github-webhook-secret
      name: GITHUB_WEBHOOK_SECRET
{% else %}
  # rovr is not declared for this cluster.
  replicaCount: 0
{% if not resources %}
  resources: null
{% endif %}
{% endif %}
