{% set maintenance = agent_runway_maintenance | default(false) -%}
app:
  fullnameOverride: agent-runway
  ecrPullSecret:
    enabled: {{agent_runway is defined}}
    region: {{aws_region}}
  networkPolicy:
    enabled: {{agent_runway is defined}}
    appPort:
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: addon-prometheus
{% if agent_runway is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-runway
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      PORT: '3000'
      DATABASE_POOL_SIZE: '4'
      AUTH_BASE_URL: https://{{agent_runway.hostname}}
      # Runway has no screens of its own; its old pages and every link it emits point here (AgentOps phase 3).
      CONSOLE_BASE_URL: https://{{agentops.hostname}}
      # AgentOps Identity signs every token this service accepts (agent-platform docs/OIDC_IDENTITY.md).
      IDENTITY_ISSUER: https://{{agentops.hostname}}/identity
      IDENTITY_URL: http://agentops-identity.agentops.svc.cluster.local:3000/identity
      AWS_REGION: {{aws_region}}
      RUNWAY_CLUSTER: {{cluster}}
      RUNWAY_SECRET_STORE: secrets-manager
      RUNWAY_KMS_KEY_ID: alias/agent-runway
      RUNWAY_POOL_HOST: postgres.delivery-pool.svc.cluster.local
      RUNWAY_POOL_PORT: '5432'
      RUNWAY_BUCKET: agent-runway-objects
      RUNWAY_SANDBOX_OBJECTS_ROLE_ARN: arn:aws:iam::{{aws_account_id}}:role/agent-runway-sandbox-objects
      RUNWAY_TENANT_OBJECTS_ROLE_ARN: arn:aws:iam::{{aws_account_id}}:role/agent-runway-tenant-objects
      RUNWAY_EKS_CLUSTER: {{cluster}}
      # Size tiers every environment shares (agent-runway docs/OPERATIONS.md, "크기"): Pod cpu and memory on eks, the
      # instance type per cloud and architecture on machine targets, and the replica range. App Pods of 2xlarge and up
      # need the larger app NodePools of terraform-env-demo demo/6-eks-node.
      RUNWAY_SIZES: '{"small":{"cpu":"100m","memory":"256Mi","replicas":1,"maxReplicas":1,"instanceTypes":{"aws":{"arm64":"t4g.small","amd64":"t3.small"},"azure":{"arm64":"Standard_D2ps_v7","amd64":"Standard_D2s_v6"}}},"medium":{"cpu":"500m","memory":"1Gi","replicas":1,"maxReplicas":2,"instanceTypes":{"aws":{"arm64":"t4g.medium","amd64":"t3.medium"},"azure":{"arm64":"Standard_D2ps_v7","amd64":"Standard_D2s_v6"}}},"large":{"cpu":"1","memory":"2Gi","replicas":1,"maxReplicas":2,"instanceTypes":{"aws":{"arm64":"m7g.large","amd64":"m7i.large"},"azure":{"arm64":"Standard_D2ps_v7","amd64":"Standard_D2s_v6"}}},"xlarge":{"cpu":"2","memory":"4Gi","replicas":1,"maxReplicas":2,"instanceTypes":{"aws":{"arm64":"m7g.xlarge","amd64":"m7i.xlarge"},"azure":{"arm64":"Standard_D4ps_v7","amd64":"Standard_D4s_v6"}}},"2xlarge":{"cpu":"4","memory":"8Gi","replicas":1,"maxReplicas":2,"instanceTypes":{"aws":{"arm64":"m7g.2xlarge","amd64":"m7i.2xlarge"},"azure":{"arm64":"Standard_D8ps_v7","amd64":"Standard_D8s_v6"}}},"4xlarge":{"cpu":"8","memory":"16Gi","replicas":1,"maxReplicas":1,"instanceTypes":{"aws":{"arm64":"m7g.4xlarge","amd64":"m7i.4xlarge"},"azure":{"arm64":"Standard_D16ps_v7","amd64":"Standard_D16s_v6"}}},"8xlarge":{"cpu":"16","memory":"32Gi","replicas":1,"maxReplicas":1,"instanceTypes":{"aws":{"arm64":"m7g.8xlarge","amd64":"m7i.8xlarge"},"azure":{"arm64":"Standard_D32ps_v7","amd64":"Standard_D32s_v6"}}}}'
{% if app_delivery is defined and app_delivery.nexus is defined %}
      RUNWAY_NEXUS_URL: https://{{app_delivery.nexus.host}}
      RUNWAY_NEXUS_USERNAME: runway-cleaner
      RUNWAY_NEXUS_IMAGE_REPOSITORY: {{app_delivery.nexus.image_repository}}
      RUNWAY_NEXUS_FILE_REPOSITORY: {{app_delivery.nexus.file_repository}}
      RUNWAY_PIPELINE_STAGES: '[{"step":"publish","tool":"Nexus"}]'
{% else %}
      RUNWAY_IMAGE_REGISTRY: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/projects
{% endif %}
{% if agent_runway.delivery is defined %}
      # App Delivery uses the app-build-v2 and app-deploy WorkflowTemplates (agent-platform docs/APP_DELIVERY.md).
      # The retired RUNWAY_WORKFLOW_TEMPLATE setting is rejected at startup.
      # The service account CA lets fetch trust the API server.
      RUNWAY_WORKFLOW_NAMESPACE: {{agent_runway.delivery.namespace}}
      RUNWAY_APP_DOMAIN: {{agent_runway.delivery.domain}}
      RUNWAY_ARGOCD_URL: https://argocd.{{agent_runway.delivery.argocd_domain}}
      # The Argo Workflows console that the pipeline's workflow links open.
      RUNWAY_WORKFLOWS_URL: https://workflows.{{agent_runway.delivery.argocd_domain}}
      # Sandbox Pods may reach the sandbox environment's postgres and valkey servers.
      RUNWAY_SANDBOX_NAMESPACE: agent-forge-workspaces
      RUNWAY_ENVIRONMENTS: '{{ agent_runway.delivery.environments | tojson }}'
      NODE_EXTRA_CA_CERTS: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
      # Azure accounts: Entra exchanges this service-account token for Key Vault and ARM tokens (federated credential
      # of agent-runway-target-secrets, terraform-env-azure dmz/8-runway-target).
      RUNWAY_AZURE_TOKEN_FILE: /var/run/secrets/azure/tokens/azure-identity-token
{% endif %}
  externalSecrets:
    enabled: true
    data:
{% if app_delivery is defined and app_delivery.nexus is defined %}
    - key: /k8s/common/nexus/runway-cleaner-password
      name: RUNWAY_NEXUS_PASSWORD
{% endif %}
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    # This service's client secret at AgentOps Identity (client runway).
    - key: /k8s/{{cluster}}/agentops-identity/client-secret-runway
      name: IDENTITY_CLIENT_SECRET
    - key: /k8s/{{cluster}}/agent-runway/pool-database-url
      name: RUNWAY_POOL_DATABASE_URL
    - key: /k8s/{{cluster}}/agent-runway/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
  routing:
    hosts:
    - {{agent_runway.hostname}}
    httpRoute:
      enabled: true
  # core_tier: the base replicas prefer the on-demand core nodes (terraform-env-demo 51-core-node-pool.tf), one per AZ.
  # HPA growth and rollout surge spill over to Spot instead of waiting for core room.
{%- if core_tier | default(false) %}
  tolerations:
    - key: opspresso.com/tier
      operator: Equal
      value: core
      effect: NoSchedule
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: opspresso.com/tier
                operator: In
                values: [core]
{%- endif %}
  # Spread the replicas over AZs and nodes so one lost node leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-runway
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-runway
      matchLabelKeys: [pod-template-hash]
{% if agent_runway.delivery is defined %}
  # The token of RUNWAY_AZURE_TOKEN_FILE: audience api://AzureADTokenExchange, which the Entra federated credentials
  # require. The kubelet renews it before it expires.
  extraVolumes:
    - name: azure-identity-token
      projected:
        sources:
          - serviceAccountToken:
              audience: api://AzureADTokenExchange
              expirationSeconds: 3600
              path: azure-identity-token
  extraVolumeMounts:
    - name: azure-identity-token
      mountPath: /var/run/secrets/azure/tokens
      readOnly: true
{% endif %}
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_runway.hostname}}
  # Prometheus reads the bearer token that the app reads as METRICS_BEARER_TOKEN.
  extraExternalSecrets:
    agent-runway-metrics:
      data:
        - key: /k8s/{{cluster}}/agent-runway/metrics-bearer-token
          name: token
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
{% endif %}
{% if app_delivery is defined and app_delivery.enabled %}

# The apps Agent Runway deploys (agent-platform docs/APP_DELIVERY.md). argocd-env-addons keeps only the AppProjects.
raw:
  resources:
    - apiVersion: argoproj.io/v1alpha1
      kind: Application
      metadata:
        namespace: argocd
        annotations:
          # Agent Runway's own removal must never reach the Applications below and their app data.
          argocd.argoproj.io/sync-options: Delete=false,Prune=false
        name: app-delivery
        labels:
          opspresso.com/cluster: "{{cluster}}"
          opspresso.com/group: "projects"
      spec:
        project: delivery
        destination:
          name: "{{cluster}}"
          namespace: app-delivery
        source:
          repoURL: https://github.com/opspresso/argocd-env-projects.git
          targetRevision: {{ app_delivery.revision | default("HEAD") | tojson }}
          path: charts/delivery
          helm:
            valuesObject:
{% if app_delivery.nexus is defined %}
              registry: "{{app_delivery.nexus.host}}/{{app_delivery.nexus.image_repository}}"
              artifactRepository: "https://{{app_delivery.nexus.host}}/repository/{{app_delivery.nexus.file_repository}}"
{% else %}
              registry: "{{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/projects"
              pushRoleArn: "arn:aws:iam::{{aws_account_id}}:role/app-delivery-push"
{% endif %}
              region: "{{aws_region}}"
              apiServer:
                cidrs: {{ app_delivery.api_server_cidrs | tojson }}
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true

    # One Application per projects/<slug>/<env> directory. Agent Runway owns the environments and writes a directory
    # only for one of them, so no list of environments lives here. Project, environment and namespace come from the
    # directory path, not from the files, and the charts/app guard checks them. A values file could still turn the guard off: the boundary is that only the
    # app-deploy step writes app.yaml, through the fixed render.jq mapping, with a deploy key that only the delivery-git
    # steps hold. The Application syncs the app chart with app.yaml (tenant objects only until the first deployment)
    # and the kro instances in resources.yaml.
    - apiVersion: argoproj.io/v1alpha1
      kind: ApplicationSet
      metadata:
        namespace: argocd
        annotations:
          # Agent Runway's own removal must never reach the Applications below and their app data.
          argocd.argoproj.io/sync-options: Delete=false,Prune=false
        name: projects
      spec:
        goTemplate: true
        goTemplateOptions: ["missingkey=error"]
        generators:
          - git:
              repoURL: https://github.com/opspresso/argocd-env-projects.git
              revision: HEAD
              requeueAfterSeconds: 30
              directories:
                - path: "projects/*/*"
        template:
          metadata:
            name: '{% raw %}app-{{ index .path.segments 1 }}-{{ .path.basename }}{% endraw %}'
            labels:
              opspresso.com/cluster: "{{cluster}}"
              opspresso.com/group: "projects"
              agentops.clush.net/delivery-project: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
              agentops.clush.net/delivery-env: '{% raw %}{{ .path.basename }}{% endraw %}'
          spec:
            project: projects
            destination:
              name: "{{cluster}}"
              namespace: '{% raw %}app-{{ index .path.segments 1 }}-{{ .path.basename }}{% endraw %}'
            sources:
              - repoURL: https://github.com/opspresso/argocd-env-projects.git
                targetRevision: HEAD
                path: charts/app
                helm:
                  valueFiles:
                    - '{% raw %}../../{{ .path.path }}/app.yaml{% endraw %}'
                  # resources.yaml may come before the first deployment writes app.yaml.
                  ignoreMissingValueFiles: true
                  # charts/app wraps the opspresso app chart; its guard refuses any other namespace, an environment
                  # name of another form, and a host that is not <slug>.<domain> or <slug>-<environment>.<domain>. Agent Runway chooses the host; the
                  # deploy step writes it to app.yaml.
                  parameters:
                    - name: app.tenant.project
                      value: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
                    - name: app.tenant.environment
                      value: '{% raw %}{{ .path.basename }}{% endraw %}'
                    - name: app.tenant.domain
                      value: "{{app_delivery.domain}}"
                    - name: app.tenant.cluster
                      value: "{{cluster}}"
                    - name: app.tenant.region
                      value: "{{aws_region}}"
                    - name: app.tenant.tenantSecretsRoleArn
                      value: "arn:aws:iam::{{aws_account_id}}:role/agent-runway-tenant-secrets"
                    # The environment namespace is an object of charts/app (app.namespace), so Argo CD deletes it with
                    # the Application; its guard checks that these labels name this project and environment.
                    - name: app.namespace.labels.agentops\.clush\.net/delivery-project
                      value: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
                    - name: app.namespace.labels.agentops\.clush\.net/delivery-env
                      value: '{% raw %}{{ .path.basename }}{% endraw %}'
              # The namespaced resources (kro instances) that resource-sync writes; AppProject projects limits the kinds.
              - repoURL: https://github.com/opspresso/argocd-env-projects.git
                targetRevision: HEAD
                path: '{% raw %}{{ .path.path }}{% endraw %}'
                directory:
                  include: resources.yaml
            # No CreateNamespace: Argo CD never deletes a namespace that option made, so a removed Project left its
            # app-<slug>-<env> namespace behind. charts/app renders the namespace with the tenant labels instead.
            syncPolicy:
              automated:
                prune: true
                selfHeal: true

    # One Application per dedicated chart resource: the postgres or valkey chart of opspresso/helm-charts at the version
    # in projects/<slug>/<env>/resources/<name>.yaml, with that file as its values. Project, environment and namespace come
    # from the path. resource-sync writes the file and checks the chart, version and value names. The Application of the
    # environment creates the namespace, so a first sync may fail and retries. The finalizer removes the workload and,
    # through the StatefulSet retention policy, its volumes when the file goes.
    - apiVersion: argoproj.io/v1alpha1
      kind: ApplicationSet
      metadata:
        namespace: argocd
        annotations:
          # Agent Runway's own removal must never reach the Applications below and their app data.
          argocd.argoproj.io/sync-options: Delete=false,Prune=false
        name: project-resources
      spec:
        goTemplate: true
        goTemplateOptions: ["missingkey=error"]
        generators:
          - git:
              repoURL: https://github.com/opspresso/argocd-env-projects.git
              revision: HEAD
              requeueAfterSeconds: 30
              files:
                - path: "projects/*/*/resources/*.yaml"
        template:
          metadata:
            name: '{% raw %}app-{{ index .path.segments 1 }}-{{ index .path.segments 2 }}-{{ trimPrefix (printf "%s-" (index .path.segments 1)) .resourceName }}-{{ trunc 8 .resourceId }}{% endraw %}'
            labels:
              opspresso.com/cluster: "{{cluster}}"
              opspresso.com/group: "projects"
              agentops.clush.net/delivery-project: '{% raw %}{{ index .path.segments 1 }}{% endraw %}'
              agentops.clush.net/delivery-env: '{% raw %}{{ index .path.segments 2 }}{% endraw %}'
            finalizers:
              - resources-finalizer.argocd.argoproj.io
          spec:
            project: projects
            destination:
              name: "{{cluster}}"
              namespace: '{% raw %}app-{{ index .path.segments 1 }}-{{ index .path.segments 2 }}{% endraw %}'
            sources:
              - repoURL: https://opspresso.github.io/helm-charts
                chart: '{% raw %}{{ .chart }}{% endraw %}'
                targetRevision: '{% raw %}{{ .chartVersion }}{% endraw %}'
                helm:
                  releaseName: '{% raw %}{{ .resourceName }}{% endraw %}'
                  valueFiles:
                    - '{% raw %}$values/{{ .path.path }}/{{ .path.filename }}{% endraw %}'
                  parameters:
                    # Reclaim policy Delete: deleting a resource does not leave a billed volume behind.
                    - name: persistence.storageClass
                      value: gp3-ephemeral
              - repoURL: https://github.com/opspresso/argocd-env-projects.git
                targetRevision: HEAD
                ref: values
            syncPolicy:
              automated:
                prune: true
                selfHeal: true
              retry:
                limit: 10
                backoff:
                  duration: 30s
                  factor: 2
                  maxDuration: 5m
{% endif %}
