{% set maintenance = agent_memory_maintenance | default(false) -%}
{% if agent_memory is defined -%}
{% set allowed_hosts = agent_memory.allowed_hosts | default([agent_memory.hostname]) -%}
{% endif -%}
app:
  fullnameOverride: agent-memory
{% if agent_memory is defined %}
{% set oidc = agent_memory.oidc | default(none) %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-memory
{% if env == 'k3s' %}
  imagePullSecrets:
    - name: ecr-registry
{% endif %}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      MEMORY_DELEGATION_ISSUER: https://studio.agrt.dev
      ADMIN_EMAILS: me@nalbam.com
      # ALLOWED_EMAIL_DOMAINS: nalbam.com
      AWS_REGION: {{aws_region}}
      DATABASE_POOL_SIZE: '4'
      AUTH_BASE_URL: https://{{agent_memory.hostname}}
{% if oidc is not none %}
      OIDC_ISSUER: {{ oidc.issuer | tojson }}
      OIDC_PROVIDER_ID: {{ oidc.provider_id | default('oidc') | tojson }}
      OIDC_SCOPES: {{ oidc.scopes | default('openid email profile') | tojson }}
      OIDC_LOGOUT_MODE: {{ oidc.logout_mode | default('app') | tojson }}
      OIDC_PROFILE_CLAIMS: {{ oidc.profile_claims | default({}) | tojson | tojson }}
{% endif %}
      AUTH_ALLOWED_HOSTS: '{{allowed_hosts | join(",")}}'
      TRUSTED_PROXY_CIDRS: '{{trusted_proxy_cidrs | join(",")}}'
      EMBEDDING_BASE_URL: https://openrouter.ai/api/v1
      EMBEDDING_MODEL: openai/text-embedding-3-small
      EMBEDDING_MIN_SCORE: '0.2'
      RERANKER_BASE_URL: https://openrouter.ai/api/v1
      RERANKER_MODEL: cohere/rerank-v3.5
      RERANKER_TIMEOUT_MS: '5000'
      RERANKER_MIN_SCORE: '0.05'
      DECISION_BASE_URL: https://openrouter.ai/api/alpha
      DECISION_MODEL: typesafe/jev-1.13
      DECISION_TIMEOUT_MS: '5000'
      MEMORY_LANGUAGE: ko
      DREAM_BASE_URL: https://openrouter.ai/api/v1
      DREAM_MODEL: openai/gpt-6-luna
      DREAM_TIME_ZONE: Asia/Seoul
  routing:
    hosts:
{%- for host in allowed_hosts %}
    - {{host}}
{%- endfor %}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_memory.hostname}}

  externalSecrets:
    enabled: true
    data:
    - key: /k8s/common/agent-memory/better-auth-secret
      name: AUTH_SECRET
{% if agent_memory.google_sign_in | default(true) %}
    - key: /k8s/common/agent-memory/google-client-id
      name: GOOGLE_CLIENT_ID
    - key: /k8s/common/agent-memory/google-client-secret
      name: GOOGLE_CLIENT_SECRET
{% endif %}
{% if oidc is not none %}
    - key: {{ oidc.client_id_parameter | tojson }}
      name: OIDC_CLIENT_ID
    - key: {{ oidc.client_secret_parameter | tojson }}
      name: OIDC_CLIENT_SECRET
{% endif %}
    - key: /k8s/common/agent-memory/embedding-api-key
      name: EMBEDDING_API_KEY
    - key: /k8s/common/agent-memory/reranker-api-key
      name: RERANKER_API_KEY
    - key: /k8s/common/agent-memory/decision-api-key
      name: DECISION_API_KEY
    # The OpenRouter key that embeddings already use; sent only to DREAM_BASE_URL.
    - key: /k8s/common/agent-memory/embedding-api-key
      name: DREAM_API_KEY
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-memory/delegation-secret
      name: MEMORY_DELEGATION_SECRET
    - key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
      name: METRICS_BEARER_TOKEN

  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'kube-system' if env == 'k3s' else 'istio-system'}}
{% if env == 'k3s' %}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-kube-system
{% endif %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'addon-alloy' if env == 'k3s' else 'addon-prometheus'}}
  registry:
    region: {{aws_region}}
{% endif %}
