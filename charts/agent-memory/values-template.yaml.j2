{% set maintenance = agent_memory_maintenance | default(false) -%}
{% if agent_memory is defined -%}
{% set allowed_hosts = agent_memory.allowed_hosts | default([agent_memory.hostname]) -%}
{% endif -%}
app:
  fullnameOverride: agent-memory
{% if agent_memory is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-memory
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      DATABASE_POOL_SIZE: '4'
      AUTH_BASE_URL: https://{{agent_memory.hostname}}
      # Studio is the only sign-in authority; the callback is /api/auth/callback/studio.
      OIDC_ISSUER: https://{{agent_studio.hostname}}/api/auth
      OIDC_PROVIDER_ID: studio
      AUTH_ALLOWED_HOSTS: '{{allowed_hosts | join(",")}}'
      TRUSTED_PROXY_CIDRS: '{{trusted_proxy_cidrs | join(",")}}'
      # Providers and credentials belong to Agent Models. agent_memory.models names the selection
      # for each role; a Settings override takes precedence after a restart.
      MODELS_URL: http://agent-models.agent-models.svc.cluster.local:3400
      EMBEDDING_MIN_SCORE: '0.2'
      RERANKER_TIMEOUT_MS: '5000'
      RERANKER_MIN_SCORE: '0.05'
      DECISION_TIMEOUT_MS: '5000'
      MEMORY_LANGUAGE: ko
      DREAM_TIME_ZONE: Asia/Seoul
      # One recall makes up to three model calls (embedding, rerank, judge). Past these limits recall silently
      # falls back to keyword search. These values pass 24 concurrent recalls; see docs/production-capacity.md.
      AI_PROVIDER_MAX_CONCURRENCY: '16'
      AI_PROVIDER_REQUESTS_PER_MINUTE: '1800'
      AI_ORGANIZATION_REQUESTS_PER_MINUTE: '3000'
      AI_USER_REQUESTS_PER_MINUTE: '300'
{%- set models = agent_memory.models | default({}) %}
{%- for key, name in [('embedding', 'EMBEDDING_MODEL'), ('reranker', 'RERANKER_MODEL'), ('decision', 'DECISION_MODEL'), ('dream', 'DREAM_MODEL')] if models[key] is defined %}
      {{name}}: {{models[key] | tojson}}
{%- endfor %}
  routing:
    hosts:
{%- for host in allowed_hosts %}
    - {{host}}
{%- endfor %}
    httpRoute:
      enabled: true
  # Every eks-demo node is Spot. Spread the replicas over AZs and nodes so one reclaim leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no Spot capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-memory
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-memory
      matchLabelKeys: [pod-template-hash]
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_memory.hostname}}

  externalSecrets:
    enabled: true
    data:
    - key: /k8s/{{cluster}}/agent-memory/auth-secret
      name: AUTH_SECRET
    - key: /k8s/{{cluster}}/agent-memory/oidc-client-id
      name: OIDC_CLIENT_ID
    - key: /k8s/{{cluster}}/agent-memory/oidc-client-secret
      name: OIDC_CLIENT_SECRET
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-memory/metrics-bearer-token
      name: METRICS_BEARER_TOKEN

  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: istio-system
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: addon-prometheus
  registry:
    region: {{aws_region}}
{% endif %}
