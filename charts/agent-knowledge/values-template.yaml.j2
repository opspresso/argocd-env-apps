{% set maintenance = agent_knowledge_maintenance | default(false) -%}
app:
  fullnameOverride: agent-knowledge
  raw:
    enabled: {{agent_knowledge is defined}}
{% if agent_knowledge is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-knowledge
{% if env == 'k3s' %}
  imagePullSecrets:
    - name: ecr-registry
{% endif %}
{% if not resources %}
  resources: null
{% endif %}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'kube-system' if env == 'k3s' else 'istio-system'}}
{% if env == 'k3s' %}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-kube-system
{% endif %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'addon-alloy' if env == 'k3s' else 'addon-prometheus'}}
  registry:
    region: {{aws_region}}
  configmap:
    enabled: true
    data:
      AWS_REGION: {{aws_region}}
      DATABASE_POOL_SIZE: '4'
      DATABASE_QUEUE_POOL_SIZE: '2'
      AI_ADMISSION_POOL_SIZE: '9'
      AUTH_BASE_URL: https://{{agent_knowledge.hostname}}
      # Studio is the only sign-in authority; the callback is /api/auth/callback/studio.
      OIDC_ISSUER: https://{{agent_studio.hostname}}/api/auth
      OIDC_PROVIDER_ID: studio
      AUTH_ALLOWED_HOSTS: '{{agent_knowledge.allowed_hosts | default([agent_knowledge.hostname]) | join(",")}}'
      TRUSTED_PROXY_CIDRS: '{{trusted_proxy_cidrs | join(",")}}'
      S3_REGION: {{aws_region}}
{% if env == 'k3s' %}
      S3_ENDPOINT: http://minio.agent-studio.svc.cluster.local:9000
      S3_BUCKET_NAME: agent-knowledge
      S3_FORCE_PATH_STYLE: 'true'
{% else %}
      S3_BUCKET_NAME: agent-knowledge-static
      S3_FORCE_PATH_STYLE: 'false'
{% endif %}
      # Providers, credentials, wire IDs and prices belong to Agent Models.
      # agent_knowledge.models names the selection for each role; a Settings override takes precedence.
      MODELS_URL: http://agent-models.agent-models.svc.cluster.local:3400
      EMBEDDING_MIN_SCORE: '0.2'
      RERANKER_TIMEOUT_MS: '5000'
      RERANKER_MIN_SCORE: '0.05'
{%- set models = agent_knowledge.models | default({}) %}
{%- for key, name in [('embedding', 'EMBEDDING_MODEL'), ('reranker', 'RERANKER_MODEL'), ('extraction', 'KNOWLEDGE_EXTRACTION_MODEL')] if models[key] is defined %}
      {{name}}: {{models[key] | tojson}}
{%- endfor %}
{%- set audio = [] %}
{%- if models.transcription is defined %}{% set _ = audio.append({'id': models.transcription, 'kind': 'transcription'}) %}{% endif %}
{%- if models.summary is defined %}{% set _ = audio.append({'id': models.summary, 'kind': 'summary'}) %}{% endif %}
{%- if audio %}
      # Processing defaults for the audio models a caller may request; selection is per job.
      AUDIO_PROCESSING_OPTIONS: {{audio | tojson | tojson}}
{%- endif %}
      DOCUMENT_WORKER_ENABLED: 'false'
      AUDIO_WORKER_ENABLED: 'false'
      KNOWLEDGE_ENRICHMENT_CONCURRENCY: '{{1 if env == "k3s" else 4}}'
      # Every replica uses the same PostgreSQL admission policy.
      AI_PROVIDER_MAX_CONCURRENCY: '8'
      AI_BATCH_MAX_CONCURRENCY: '4'
  routing:
    hosts:
    - {{agent_knowledge.hostname}}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_knowledge.hostname}}
  externalSecrets:
    enabled: true
    data:
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-knowledge/better-auth-secret
      name: AUTH_SECRET
    - key: /k8s/{{cluster}}/agent-knowledge/oidc-client-id
      name: OIDC_CLIENT_ID
    - key: /k8s/{{cluster}}/agent-knowledge/oidc-client-secret
      name: OIDC_CLIENT_SECRET
    - key: /k8s/{{cluster}}/agent-knowledge/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
{% if env == 'k3s' %}
    - key: /k8s/{{cluster}}/agent-studio/minio-root-user
      name: S3_ACCESS_KEY_ID
    - key: /k8s/{{cluster}}/agent-studio/minio-root-password
      name: S3_SECRET_ACCESS_KEY
{% endif %}
  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}
  workloads:
    worker:
      enabled: true
      replicas: {{0 if maintenance else 1}}
{% endif %}
