{% set maintenance = agent_models_maintenance | default(false) -%}
app:
  fullnameOverride: agent-models
  raw:
    enabled: {{agent_models is defined}}
{% if agent_models is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-models
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      # Transactions are short ledger/session writes; upstream calls never hold a connection.
      DATABASE_POOL_SIZE: '8'
      AUTH_BASE_URL: https://{{agent_models.hostname}}
      OIDC_ISSUER: https://{{agent_studio.hostname}}/api/auth
      OIDC_PROVIDER_ID: studio
      MODELS_REQUEST_TIMEOUT_MS: '600000'
      MODELS_SHUTDOWN_GRACE_MS: '600000'
      MODELS_MAX_CONCURRENT_REQUESTS: '64'
      MODELS_MAX_REQUEST_BYTES: '100663296'
      MODELS_MAX_STREAM_BUFFER_BYTES: '268435456'
      AWS_REGION: {{aws_region}}
  externalSecrets:
    enabled: true
    data:
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-models/auth-secret
      name: AUTH_SECRET
    - key: /k8s/{{cluster}}/agent-models/aes-encryption-key
      name: AES_ENCRYPTION_KEY
    - key: /k8s/{{cluster}}/agent-models/oidc-client-id
      name: OIDC_CLIENT_ID
    - key: /k8s/{{cluster}}/agent-models/oidc-client-secret
      name: OIDC_CLIENT_SECRET
  routing:
    hosts:
    - {{agent_models.hostname}}
    httpRoute:
      enabled: true
  # Every eks-demo node is Spot. Spread the replicas over AZs and nodes so one reclaim leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no Spot capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-models
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-models
      matchLabelKeys: [pod-template-hash]
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_models.hostname}}
  ingressPeers:
  - namespaceSelector:
      matchLabels:
        kubernetes.io/metadata.name: istio-system
  registry:
    region: {{aws_region}}
{% endif %}
