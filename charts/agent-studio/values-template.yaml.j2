{% set maintenance = agent_studio_maintenance | default(false) -%}
{% if agent_studio is defined -%}
{% set allowed_hosts = agent_studio.allowed_hosts | default([agent_studio.hostname]) -%}
{% endif -%}
app:
  fullnameOverride: agent-studio
{% if agent_studio is defined %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-studio
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      STAGE: '{{phase}}'
      DATABASE_POOL_SIZE: '4'
      SERVICE_NAME: '{{agent_studio.service.name}}'
      AWS_REGION: {{aws_region}}
      # AgentOps Identity signs every token Studio accepts and holds people, teams and Git connections
      # (agent-platform docs/OIDC_IDENTITY.md). Sign-in, admins and Git hosts are Identity settings (charts/agentops).
      IDENTITY_ISSUER: https://{{agentops.hostname}}/identity
      IDENTITY_URL: http://agentops-identity.agentops.svc.cluster.local:3000/identity
      # Studio's public origin: the Agent API base, webhook addresses and MCP OAuth client metadata.
      PUBLIC_BASE_URL: https://{{agent_studio.hostname}}
      S3_BUCKET_NAME: agent-studio-static
      ARTIFACT_ACCESS_MODE: proxied
      CATALOG_ENABLED: 'true'
      SLACK_LOADING_INDICATOR: ':loading:'
      EMBEDDING_DIM: native
      CATALOG_MIN_SCORE: '0.2'
      RERANKER_MIN_SCORE: '0.05'
      UNKNOWN_MODEL_POLICY: allow
      # Agent Models owns provider connections, credentials, selections and usage.
      MODELS_URL: http://agent-models.agent-models.svc.cluster.local:3000
      MODELS_PUBLIC_URL: https://{{agent_models.hostname}}
{%- if agent_studio.model_usage is defined %}
      MODEL_USAGE_DEFAULTS: {{agent_studio.model_usage | tojson | tojson}}
{%- endif %}
      # The AgentOps console that serves Studio's screens; production Studio refuses to boot without it.
      CONSOLE_BASE_URL: https://{{agentops.hostname}}
      MAX_RUN_DURATION_MS: '600000'
      MAX_CONCURRENT_RUNS_PER_ACTOR: '{{agent_studio.max_concurrent_runs_per_actor | default(0)}}'
{%- if agent_studio.member_tier_defaults is defined %}
      MEMBER_TIER_DEFAULTS: {{agent_studio.member_tier_defaults | tojson | tojson}}
{%- endif %}
{%- if agent_studio.capability_visibility_defaults is defined %}
      CAPABILITY_VISIBILITY_DEFAULTS: {{agent_studio.capability_visibility_defaults | tojson | tojson}}
{%- endif %}
      MCP_INTERNAL_HOST_SUFFIXES: agent-mcps.svc.cluster.local,agent-memory.svc.cluster.local,agent-knowledge.svc.cluster.local,agent-forge.svc.cluster.local{{',agent-runway.svc.cluster.local' if (agent_runway is defined and agent_runway.connected | default(false)) else ''}}
      FORGE_URL: http://agent-forge.agent-forge.svc.cluster.local:3000
      MEMORY_URL: http://agent-memory.agent-memory.svc.cluster.local:3000
      KNOWLEDGE_URL: http://agent-knowledge.agent-knowledge.svc.cluster.local:3000
{%- if (agent_runway is defined and agent_runway.connected | default(false)) %}
      RUNWAY_URL: http://agent-runway.agent-runway.svc.cluster.local:3000
{%- endif %}
      PLUGINS_REPO: opspresso/agent-plugins
      PLUGINS_REPO_BRANCH: main
      # PR review reaches GitHub with the caller's GitHub MCP grant.
      GITHUB_API_URL: https://api.github.com
      GITHUB_WEB_URL: https://github.com
  routing:
    hosts:
{%- for host in allowed_hosts %}
    - {{host}}
{%- endfor %}
    httpRoute:
      enabled: true
  # core_tier: the base replicas prefer the on-demand core nodes (terraform-env-demo 51-core-node-pool.tf), one per AZ.
  # HPA growth and rollout surge spill over to Spot instead of waiting for core room.
{%- if core_tier | default(false) %}
  tolerations:
    - key: opspresso.com/tier
      operator: Equal
      value: core
      effect: NoSchedule
  affinity:
    nodeAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: opspresso.com/tier
                operator: In
                values: [core]
{%- endif %}
  # Spread the replicas over AZs and nodes so one lost node leaves a replica serving.
  # ScheduleAnyway: a replica still starts when one AZ has no capacity.
  topologySpreadConstraints:
    - maxSkew: 1
      topologyKey: topology.kubernetes.io/zone
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-studio
      matchLabelKeys: [pod-template-hash]
    - maxSkew: 1
      topologyKey: kubernetes.io/hostname
      whenUnsatisfiable: ScheduleAnyway
      labelSelector:
        matchLabels:
          app.kubernetes.io/name: agent-studio
      matchLabelKeys: [pod-template-hash]
  podLabels:
    sidecar.istio.io/inject: "true"
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_studio.hostname}}

  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}

  externalSecrets:
    enabled: true
    data:
    # Studio's client secret at AgentOps Identity (client studio).
    - key: /k8s/{{cluster}}/agentops-identity/client-secret-studio
      name: IDENTITY_CLIENT_SECRET
    - key: /k8s/{{cluster}}/agent-studio/aes-encryption-key
      name: AES_ENCRYPTION_KEY
    - key: /k8s/{{cluster}}/agent-studio/plugins-repo-token
      name: PLUGINS_REPO_TOKEN
    - key: /k8s/{{cluster}}/agent-studio/schedule-scan-token
      name: SCHEDULE_SCAN_TOKEN
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
    - key: /k8s/{{cluster}}/agent-studio/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
  networkPolicy:
    appPort:
      from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-system
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: addon-prometheus
  ecrPullSecret:
    region: {{aws_region}}
  workloads:
    scheduleTicker:
      enabled: true
      replicas: {{0 if maintenance else 1}}
{%- if core_tier | default(false) %}
      tolerations:
        - key: opspresso.com/tier
          operator: Equal
          value: core
          effect: NoSchedule
      affinity:
        nodeAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              preference:
                matchExpressions:
                  - key: opspresso.com/tier
                    operator: In
                    values: [core]
{%- endif %}

{%- endif %}
