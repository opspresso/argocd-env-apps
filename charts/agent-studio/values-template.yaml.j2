{% set maintenance = agent_studio_maintenance | default(false) -%}
{% if agent_studio is defined -%}
{% set allowed_hosts = agent_studio.allowed_hosts | default([agent_studio.hostname]) -%}
{% endif -%}
app:
  fullnameOverride: agent-studio
{% if agent_studio is defined %}
{% set oidc = agent_studio.oidc | default(none) %}
  replicaCount: {{0 if maintenance else replicas}}
  autoscaling:
    enabled: {{false if maintenance else autoscaling}}
  image:
    repository: {{aws_account_id}}.dkr.ecr.{{aws_region}}.amazonaws.com/agent-studio
{% if env == 'k3s' %}
  imagePullSecrets:
    - name: ecr-registry
{% endif %}
{% if not resources %}
  resources: null
{% endif %}
  configmap:
    enabled: true
    data:
      STAGE: '{{phase}}'
      DATABASE_POOL_SIZE: '4'
      SERVICE_NAME: '{{agent_studio.service.name}}'
      SERVICE_LOGO: '{{agent_studio.service.logo}}'
{% if agent_studio.service.copyright is defined %}
      SERVICE_COPYRIGHT: {{agent_studio.service.copyright | tojson}}
{% endif %}
      ADMIN_EMAILS: me@nalbam.com
      # ALLOWED_EMAIL_DOMAINS: nalbam.com
      AWS_REGION: {{aws_region}}
      AUTH_BASE_URL: https://{{agent_studio.hostname}}
{%- if agent_studio.password_sign_in | default(true) %}
      AUTH_PASSWORD: 'true'
{%- endif %}
{% if oidc is not none %}
      OIDC_ISSUER: {{ oidc.issuer | tojson }}
      OIDC_PROVIDER_ID: {{ oidc.provider_id | default('oidc') | tojson }}
      OIDC_SCOPES: {{ oidc.scopes | default('openid email profile') | tojson }}
      OIDC_LOGOUT_MODE: {{ oidc.logout_mode | default('app') | tojson }}
      OIDC_PROFILE_CLAIMS: {{ oidc.profile_claims | default({}) | tojson | tojson }}
      OIDC_DISPLAY_NAME: {{ oidc.display_name | default("SSO") | tojson }}
{% endif %}
      AUTH_ALLOWED_HOSTS: '{{allowed_hosts | join(",")}}'
      # PUBLIC_BASE_URL: https://{{agent_studio.hostname}}
      S3_BUCKET_NAME: agent-studio-static
{% if env == 'k3s' %}
      S3_ENDPOINT: http://minio.agent-studio.svc.cluster.local:9000
{% endif %}
      ARTIFACT_ACCESS_MODE: proxied
      CATALOG_ENABLED: 'true'
      SLACK_LOADING_INDICATOR: ':loading:'
      TRUSTED_PROXY_CIDRS: '{{trusted_proxy_cidrs | join(",")}}'
      EMBEDDING_DIM: native
      CATALOG_MIN_SCORE: '0.2'
{% if env == 'k3s' %}
      RERANKER_MIN_SCORE: '0.01'
{% else %}
      RERANKER_MIN_SCORE: '0.05'
{% endif %}
      UNKNOWN_MODEL_POLICY: allow
      # Agent Models owns provider connections, credentials, selections and usage.
      MODELS_URL: http://agent-models.agent-models.svc.cluster.local:3400
      MODELS_PUBLIC_URL: https://{{agent_models.hostname}}
      # Service consoles that may frame Studio's Helper panel (agent-platform/docs/HELPER_EMBED.md).
{%- set helper_consoles = [] %}
{%- for service in [agent_memory, agent_knowledge, agent_forge, agent_delivery] if service is defined and service.hostname is defined %}
{%- set _ = helper_consoles.append("https://" ~ service.hostname) %}
{%- endfor %}
      HELPER_EMBED_ORIGINS: '{{ helper_consoles | join(",") }}'
      MAX_RUN_DURATION_MS: '600000'
      MAX_CONCURRENT_RUNS_PER_ACTOR: '60'
      MCP_INTERNAL_HOST_SUFFIXES: agent-mcps.svc.cluster.local,agent-memory.svc.cluster.local,agent-knowledge.svc.cluster.local,agent-forge.svc.cluster.local{{',agent-delivery.svc.cluster.local' if (agent_delivery is defined and agent_delivery.connected | default(false)) else ''}}
      FORGE_URL: http://agent-forge.agent-forge.svc.cluster.local:3103
      MEMORY_URL: http://agent-memory.agent-memory.svc.cluster.local:3000
      KNOWLEDGE_URL: http://agent-knowledge.agent-knowledge.svc.cluster.local:3000
{%- if (agent_delivery is defined and agent_delivery.connected | default(false)) %}
      DELIVERY_URL: http://agent-delivery.agent-delivery.svc.cluster.local:3500
{%- endif %}
      PLUGINS_REPO: opspresso/agent-plugins
      PLUGINS_REPO_BRANCH: main
      # PR review reaches GitHub with the caller's GitHub MCP grant.
      GITHUB_API_URL: https://api.github.com
      GITHUB_WEB_URL: https://github.com
  routing:
    hosts:
{%- for host in allowed_hosts %}
    - {{host}}
{%- endfor %}
    httpRoute:
      enabled: true
{% if env == 'k3s' %}
      parentRefs:
        - name: traefik-gateway
          namespace: traefik-gateway
{% endif %}
{% if env != 'k3s' %}
  podLabels:
    sidecar.istio.io/inject: "true"
{% endif %}
  podAnnotations:
    link.argocd.argoproj.io/external-link: https://{{agent_studio.hostname}}

  serviceMonitor:
    enabled: {{ (metrics is defined and metrics.backend == 'prometheus') | lower }}
    labels:
      release: prometheus-{{cluster}}

  externalSecrets:
    enabled: true
    data:
    - key: /k8s/common/{{agent_studio.service.key}}/better-auth-secret
      name: AUTH_SECRET
{% if agent_studio.google_sign_in | default(true) %}
    - key: /k8s/common/{{agent_studio.service.key}}/google-client-id
      name: GOOGLE_CLIENT_ID
    - key: /k8s/common/{{agent_studio.service.key}}/google-client-secret
      name: GOOGLE_CLIENT_SECRET
{% endif %}
{% if oidc is not none %}
    - key: {{ oidc.client_id_parameter | tojson }}
      name: OIDC_CLIENT_ID
    - key: {{ oidc.client_secret_parameter | tojson }}
      name: OIDC_CLIENT_SECRET
{% endif %}
    - key: /k8s/common/agent-studio/aes-encryption-key
      name: AES_ENCRYPTION_KEY
    - key: /k8s/common/agent-studio/github-token
      name: PLUGINS_REPO_TOKEN
    - key: /k8s/common/agent-studio/schedule-scan-token
      name: SCHEDULE_SCAN_TOKEN
    - key: /k8s/{{cluster}}/agent-platform/database-url
      name: DATABASE_URL
{% if env == 'k3s' %}
    - key: /k8s/{{cluster}}/agent-studio/minio-root-user
      name: S3_ACCESS_KEY_ID
    - key: /k8s/{{cluster}}/agent-studio/minio-root-password
      name: S3_SECRET_ACCESS_KEY
{% endif %}
    - key: /k8s/{{cluster}}/agent-studio/metrics-bearer-token
      name: METRICS_BEARER_TOKEN
    - key: /k8s/{{cluster}}/agent-forge/organization-id
      name: FORGE_ORGANIZATION_ID
    # Studio registers each service client; the service and Studio read the same client ID.
{% for service in ('forge', 'memory', 'knowledge') + (('delivery',) if (agent_delivery is defined and agent_delivery.connected | default(false)) else ()) %}
    - key: /k8s/{{cluster}}/agent-{{service}}/oidc-client-id
      name: {{service | upper}}_OIDC_CLIENT_ID
{% endfor %}
  ingressPeers:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'kube-system' if env == 'k3s' else 'istio-system'}}
{% if env == 'k3s' %}
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
          app.kubernetes.io/instance: traefik-kube-system
{% endif %}
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{'addon-alloy' if env == 'k3s' else 'addon-prometheus'}}
  registry:
    region: {{aws_region}}
  workloads:
    scheduleTicker:
      enabled: true
      replicas: {{0 if maintenance else 1}}

{%- endif %}
